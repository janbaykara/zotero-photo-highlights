{
  "name": "zotero-plugin",
  "type": "module",
  "version": "0.1.0",
  "description": "Blank Zotero plugin shell",
  "config": {
    "addonName": "Zotero Plugin",
    "addonID": "plugin@janbaykara.com",
    "addonRef": "plugin",
    "addonInstance": "Plugin",
    "prefsPrefix": "extensions.zotero.plugin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janbaykara/zotero-plugin.git"
  },
  "author": "Jan Baykara <janbaykara@pm.me>",
  "bugs": {
    "url": "https://github.com/janbaykara/zotero-plugin/issues"
  },
  "homepage": "https://github.com/janbaykara/zotero-plugin",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build:css": "node scripts/build-css.js",
    "watch:css": "npx @tailwindcss/cli -i ./src/tailwind.css -o ./addon/content/tailwind.css --watch",
    "start": "concurrently \"pnpm watch:css\" \"zotero-plugin serve\"",
    "build": "NODE_ENV=production pnpm build:css && pnpm lint:check && NODE_ENV=production pnpm zotero-plugin build && NODE_ENV=production pnpm tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "pnpm lint:check && NODE_ENV=production zotero-plugin release",
    "test": "zotero-plugin test --no-watch",
    "update-deps": "pnpm update --save"
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/collision": "^0.5.0",
    "@dnd-kit/geometry": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/state": "^0.5.0",
    "@janbaykara/zotero-annotations": "workspace:*",
    "@janbaykara/zotero-cache": "workspace:*",
    "@janbaykara/zotero-chrome": "workspace:*",
    "@janbaykara/zotero-csl": "workspace:*",
    "@janbaykara/zotero-dnd": "workspace:*",
    "@janbaykara/zotero-jotai-state": "workspace:*",
    "@janbaykara/zotero-os-file-drop": "workspace:*",
    "@janbaykara/zotero-preact": "workspace:*",
    "@janbaykara/zotero-tailwind-theme": "workspace:*",
    "concurrently": "^9.2.1",
    "jotai": "^3.0.1",
    "jotai-family": "^1.1.0",
    "lru-cache": "^11.5.2",
    "preact": "^10.29.8",
    "verzod": "^0.5.1",
    "zod": "^3.25.76",
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
